<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.hierograph</groupId>
        <artifactId>hierograph-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../hierograph-parent/pom.xml</relativePath>
    </parent>

    <artifactId>io.hierograph.maven.plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>Hierograph Maven Plugin</name>
    <description>
        Scans a Maven project's compiled modules into Hierograph `.hierograph` snapshots during the build:
        the `scan` goal scans each module keyed by its GAV (capturing its dependency classpath), and the
        `aggregate` goal collects the reactor's archives into one snapshot directory the MCP server consumes.
    </description>

    <properties>
        <maven.api.version>3.9.9</maven.api.version>
        <maven.plugin.tools.version>3.13.1</maven.plugin.tools.version>
    </properties>

    <dependencies>
        <!-- The scanner + the Parquet writer/model it produces. -->
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.graphstore.scanner</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.graphstore.parquet</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.graphstore.model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <!-- Maven plugin API (provided by the running Maven). -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.tools.version}</version>
                <configuration>
                    <goalPrefix>hierograph</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
