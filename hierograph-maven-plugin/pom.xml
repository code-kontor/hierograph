<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.hierograph</groupId>
        <artifactId>hierograph-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../hierograph-parent/pom.xml</relativePath>
    </parent>

    <artifactId>io.hierograph.maven.plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>Hierograph Maven Plugin</name>
    <description>
        Records a Maven reactor's module layout for the Hierograph MCP server during the build: the `register`
        goal writes a per-module fragment (GAV, compiled-output directories and the resolved classpath), and
        the `manifest` goal merges them into one top-level `.hierograph/manifest.json`. The server does the
        scanning — the plugin only reports what the build tool knows, so it pulls in no scanner or Parquet
        dependencies.
    </description>

    <properties>
        <maven.api.version>3.9.9</maven.api.version>
        <maven.plugin.tools.version>3.13.1</maven.plugin.tools.version>
        <gson.version>2.11.0</gson.version>
    </properties>

    <dependencies>
        <!-- JSON read/write for the manifest (self-contained, no transitive dependencies). -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <!-- Maven plugin API (provided by the running Maven). -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.tools.version}</version>
                <configuration>
                    <goalPrefix>hierograph</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
