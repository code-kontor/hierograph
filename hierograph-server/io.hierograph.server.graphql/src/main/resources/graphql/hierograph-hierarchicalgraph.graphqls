extend type HierarchicalGraph {

    "The root node's id."
    identifier: ID!

    "The root of the tree. Its children are the modules."
    rootNode: Node!

    "The node with this id, or `null` (with a NOT_FOUND error) when it names no node."
    node(id: ID!): Node

    """
    The nodes with these ids, in argument order, duplicates kept. Ids that name no node are left out and
    reported in a NOT_FOUND error.
    """
    nodes(ids: [ID!]!): NodeSet

    """
    Finds nodes by name — the name-based entry point (every other field takes ids). Case-insensitive
    substring match on the node's simple name and fully-qualified name, ranked best first: exact name,
    exact fully-qualified name, name prefix, then substring anywhere; ties go to the shorter
    fully-qualified name. Same matching and ranking as the MCP find_node tool.

    `kinds` restricts the result to node kinds (e.g. "java.class", "java.method", "java.package",
    "java.module", "external.type") and/or the group aliases "types", "members", "packages". Without
    `kinds`, only modules, packages and types are searched — methods and fields only when requested. An
    unknown kind is a BAD_REQUEST listing the valid values.

    `limit` caps the result (1..200, default 50); the result is the top `limit` matches, not a page.
    """
    findNodes(name: String!, kinds: [String!], limit: Int = 50): [Node!]!

    """
    The dependency with this id (`<source id>_<target id>_<type>`), or `null` (with a NOT_FOUND error)
    when it names no dependency. A malformed id is a BAD_REQUEST.
    """
    dependency(id: ID!): Dependency

    """
    The dependencies with these ids, in argument order without duplicates. Ids that name no dependency are
    left out and reported in a NOT_FOUND error; a malformed id is a BAD_REQUEST.
    """
    dependencies(ids: [ID!]!): DependencySet

    """
    The dependencies from anywhere in the source node's subtree to anywhere in the target node's subtree:
    the dependencies behind one cell of a dependency structure matrix. `null` when no dependency connects
    the two subtrees, or (with a NOT_FOUND error) when an id names no node.
    """
    dependencySetForAggregatedDependency(sourceNodeId: ID!, targetNodeId: ID!): DependencySet

    """
    Each pair's aggregated dependency: its weight from anywhere in the source node's subtree to anywhere in
    the target node's subtree, in argument order, duplicates kept. Unlike the other fields, an id that names
    no node is not an error: its end comes back `null` and the weight 0, so a client holding ids from an
    older graph (a link) tells per pair what no longer resolves. At most 1000 pairs; more is a BAD_REQUEST.
    """
    aggregatedDependencies(pairs: [NodePair!]!): [NodePairDependency!]!
}

"Which side of a dependency a node is on."
enum NodeType {
    "The depending end."
    SOURCE
    "The end depended upon."
    TARGET
}

"How the `filter*` fields expand each given node before matching."
enum NodesToConsider {
    "The node alone."
    SELF,
    "The node and its direct children."
    SELF_AND_CHILDREN,
    "The node and all its descendants."
    SELF_AND_SUCCESSORS
}

"""
An ordered list of nodes. Fields that take node ids match subtrees: a package id stands for every type
below it. Ids that name no node are ignored and reported in a NOT_FOUND error.
"""
type NodeSet {

    "The nodes, in set order."
    nodes: [Node!]!

    "Their ids, in the same order."
    nodeIds: [ID!]!

    """
    The dependencies into the members' subtrees from outside all of them: the set taken as one group, as
    `Node.incomingDependencies` takes one subtree. Dependencies between members are inside the group and left
    out. In member order, each dependency once.
    """
    incomingDependencies: DependencySet!

    "The dependencies from the members' subtrees to outside all of them; the mirror image of `incomingDependencies`."
    outgoingDependencies: DependencySet!

    "The dependency structure matrix over the set: dependents first, cycles as contiguous blocks."
    orderedAdjacencyMatrix: OrderedAdjacencyMatrix!

    """
    The set in rows by level, as a levelized structure map draws a container's children (`children.levelization`):
    a member sits one row above the highest member it depends on, the members of a cycle (a tangle) share a row,
    and only the feedback dependencies inside the tangles point against the levels.
    """
    levelization: Levelization!

    """
    The nodes the members depend on, without duplicates. A member's dependencies inside its own subtree
    are not references and are left out. With `includePredecessors`, each result node is followed by its
    ancestors up to the root.
    """
    referencedNodes(includePredecessors: Boolean! = false): NodeSet!

    "The nodes that depend on the members, leaving out each member's own subtree. See `referencedNodes`."
    referencingNodes(includePredecessors: Boolean! = false): NodeSet!

    "The members' referenced nodes that lie in `nodeIds`, each id expanded by `nodesToConsider`."
    filterReferencedNodes(nodeIds: [ID!]!, nodesToConsider: NodesToConsider!, includePredecessors: Boolean! = false): NodeSet!

    "The members' referencing nodes that lie in `nodeIds`, each id expanded by `nodesToConsider`."
    filterReferencingNodes(nodeIds: [ID!]!, nodesToConsider: NodesToConsider!, includePredecessors: Boolean! = false): NodeSet!
}

"""
A node of the tree: a module, a package, a type or a member. Only types are ends of dependencies; a
package or module depends on what the types below it depend on. Fields that take node ids match subtrees:
a package id stands for every type below it. Ids that name no node are ignored and reported in a
NOT_FOUND error.
"""
type Node {

    "The node's id: a numeric handle, stable across rescans and restarts while the node exists."
    id: ID!

    """
    The qualified name: the type's fully-qualified name, the package name, the artifact key for a module,
    `<owner fqn>#<signature>` for a member; empty for the root.
    """
    text: String!

    "The node's kind, e.g. `java.module`, `java.package`, `java.class`, `external.type`; `Unknown` for the root."
    type: String!

    "The parent; `null` for the root."
    parent: Node

    """
    The ancestors, nearest first, up to and including the root. With `compact`, the ancestors as a folded tree
    shows them: without the packages skipped by chain folding (see `children`).
    """
    predecessors(compact: Boolean! = false): [Node!]!

    "Whether the node has children, so a tree view can draw an expander without loading them."
    hasChildren: Boolean!

    """
    The children, in tree order. With `compact`, the display children of chain folding: a chain of lone
    packages (a package holding nothing but one package, and so on down) is replaced by its last package, which
    names the packages it stands for in `compactedFrom`. Folding changes no dependency and no weight, so
    `children(compact: true).levelization` levelizes the chain ends. Packages fold wherever they are; a chain
    never crosses a module, a view group or External Types.
    """
    children(compact: Boolean! = false): NodeSet!

    """
    The packages this node stands for in a folded tree, outermost first: the lone packages directly above it
    that chain folding skips. Empty when the node isn't folded, and for a skipped package itself.
    """
    compactedFrom: [Node!]!

    """
    The node's name in a folded tree: a folded node by its qualified name relative to the package it is shown
    under (`server.mcp` under `io.hierograph`), in full under a module (`io.hierograph.server`); any other node
    by its own name.
    """
    displayText: String!

    """
    Where the node is shown in a folded tree: itself, or for a package that chain folding skips the end of its
    chain. A link or search hit naming a skipped package is revealed there.
    """
    displayNode: Node!

    """
    The children whose subtree depends on the subtree of at least one of the given nodes. With `compact`, of
    the display children of chain folding, as `children(compact: true)` has them.
    """
    childrenFilteredByReferencedNodes(referencedNodeIds: [ID!]!, compact: Boolean! = false): NodeSet!

    """
    The children whose subtree is depended on by the subtree of at least one of the given nodes. With
    `compact`, of the display children (see `childrenFilteredByReferencedNodes`).
    """
    childrenFilteredByReferencingNodes(referencingNodeIds: [ID!]!, compact: Boolean! = false): NodeSet!

    """
    The children whose subtree holds at least one of the given nodes (or is one of them): the path down to
    them, a level at a time. With `compact`, of the display children (see `childrenFilteredByReferencedNodes`).
    """
    childrenContainingNodes(nodeIds: [ID!]!, compact: Boolean! = false): NodeSet!

    """
    Key-value facts about the node (`fqn`, `name`, `kind`, counts, modifiers, source file, …). Resolved in
    one batch for all nodes of a response, and only when selected.
    """
    properties: [MapEntry!]!

    "The dependencies from this subtree into the subtree of one of the given nodes."
    dependenciesTo(targetNodes: [ID!]!): [Dependency!]!

    "The dependencies into this subtree from the subtree of one of the given nodes."
    dependenciesFrom(sourceNodes: [ID!]!): [Dependency!]!

    """
    The dependencies into this subtree from outside it: those whose target lies in the subtree and whose
    source doesn't. Dependencies inside the subtree are left out, as `referencingNodes` leaves them out.
    In the order of the subtree's accumulated incoming dependencies.
    """
    incomingDependencies: DependencySet!

    "The dependencies from this subtree to outside it; the mirror image of `incomingDependencies`."
    outgoingDependencies: DependencySet!

    """
    The nodes this subtree depends on, leaving out its own subtree. With `includePredecessors`, each
    result node is followed by its ancestors up to the root.
    """
    referencedNodes(includePredecessors: Boolean! = false): NodeSet!

    "The nodes that depend on this subtree, leaving out its own subtree. See `referencedNodes`."
    referencingNodes(includePredecessors: Boolean! = false): NodeSet!

    "The referenced nodes that lie in `nodeIds`, each id expanded by `nodesToConsider`."
    filterReferencedNodes(nodeIds: [ID!]!, nodesToConsider: NodesToConsider!, includePredecessors: Boolean! = false): NodeSet!

    "The referencing nodes that lie in `nodeIds`, each id expanded by `nodesToConsider`."
    filterReferencingNodes(nodeIds: [ID!]!, nodesToConsider: NodesToConsider!, includePredecessors: Boolean! = false): NodeSet!
}

"A direct dependency between two types."
type Dependency {
    "`<source id>_<target id>_<type>`; accepted by `dependency(id)`."
    id: ID!
    "The depending type."
    sourceNode: Node!
    "The type depended upon."
    targetNode: Node!
    "The dependency's type, `DEPENDS_ON`."
    type: String!
    "The number of individual references from source to target."
    weight: Int!
    "What the references are, by kind, the most frequent first; empty for a graph that doesn't record kinds."
    kinds: [DependencyKindCount!]!
}

"How many of a dependency's references are of one kind."
type DependencyKindCount {
    "The kind: `extends`, `implements`, `calls`, `has_type`, `parameter_type`, `returns`, … (as `DependencyKind` names it)."
    kind: String!
    count: Int!
}

"A dependency structure matrix over a node set."
type OrderedAdjacencyMatrix {
    "The set in matrix order: dependents first, each cycle a contiguous block."
    orderedNodes: [Node!]!
    "The non-zero cells, row by row."
    cells: [Cell!]!
    "The cycles: components of more than one node. Empty for an acyclic set."
    stronglyConnectedComponents: [StronglyConnectedComponent!]!
}

"""
A node set in rows by level. Every dependency between two members points down, except the feedback
dependencies inside the tangles.
"""
type Levelization {
    "The rows, bottom first: `levels[0]` holds the members that depend on no other member."
    levels: [Level!]!
    "The cycles of two or more members, each on one row, in matrix order of their first member."
    tangles: [Tangle!]!
    """
    The dependencies against a tangle's order, from a member to one placed before it, heaviest first: the
    cheapest set whose removal untangles the tangles, and so the refactoring candidates.
    """
    feedbackDependencies: [FeedbackDependency!]!
}

"One row of a levelization."
type Level {
    "The row, 0 at the bottom."
    index: Int!
    "The members in the row, in matrix order (dependents first, a tangle's members together); the order carries no other meaning."
    nodes: [Node!]!
}

"A cycle of two or more members of a levelized set."
type Tangle {
    "The row the tangle sits in."
    level: Int!
    "The members, dependents first, in the order that keeps the heaviest dependencies pointing down."
    nodes: [Node!]!
    "The members in rows inside the tangle, bottom first: a member sits above the later members it depends on."
    rows: [Level!]!
}

"A dependency between two members of a tangle that points against the tangle's order."
type FeedbackDependency {
    "The member that depends."
    sourceNode: Node!
    "The member depended upon, placed before the source in the tangle's order."
    targetNode: Node!
    "The summed weight of the dependencies from the source's subtree into the target's."
    weight: Int!
    "Those dependencies, between types: what has to change to remove it."
    dependencies: DependencySet!
}

"One non-zero cell of a dependency structure matrix."
type Cell {
    "Index into `orderedNodes` of the depending node."
    row: Int!
    "Index into `orderedNodes` of the node depended upon."
    column: Int!
    "The summed weight of the dependencies from the row's subtree into the column's; on the diagonal, the internal weight."
    value: Int!
}

"A cycle in a dependency structure matrix. The three lists are parallel: `orderedNodes[nodePositions[k]]` is `nodes[k]`."
type StronglyConnectedComponent {
    "The cycle's nodes, in matrix order."
    nodes: [Node!]!
    "Their ids, in the same order."
    nodeIds: [ID!]!
    "Their indices into `orderedNodes`, in the same order."
    nodePositions: [Int!]!
}

"Where a page sits in its dependency list."
type PageInfo {
    "The requested page, 1-based."
    pageNumber: Int!
    "The number of non-empty pages; 0 for an empty list."
    maxPages: Int!
    "The requested page size."
    pageSize: Int!
    "The number of dependencies in the whole list."
    totalCount: Int!
}

"One page of a dependency list."
type DependencyPage {
    "Where the page sits."
    pageInfo: PageInfo!
    "The page's dependencies; empty past the last page."
    dependencies: [Dependency!]!
}

"An ordered list of dependencies."
type DependencySet {

    "The number of dependencies."
    size: Int!

    "The individual references the dependencies stand for: the sum of their weights."
    references: Int!

    "All dependencies, in set order."
    dependencies: [Dependency!]!

    "One 1-based page of `pageSize` dependencies. `null`, with a BAD_REQUEST, when either argument is below 1."
    dependencyPage(pageNumber: Int!, pageSize: Int!): DependencyPage

    """
    The children of `parentNode` whose subtree contains a source (SOURCE) or target (TARGET) of a
    dependency in the set: drills the set down one level. With `compact`, of the display children, as
    `Node.children(compact: true)` folds them: a chain of lone packages is one child, its last package.
    Empty (with a NOT_FOUND error) when `parentNode` names no node.
    """
    filteredChildren(parentNode: ID!, parentNodeType: NodeType!, compact: Boolean! = false): [Node!]!

    "The ids of `filteredChildren`."
    filteredChildrenIds(parentNode: ID!, parentNodeType: NodeType!, compact: Boolean! = false): [ID!]!

    """
    `filteredChildren` with, for each child, how many of the dependencies have their end on that side in
    its subtree, and their references: what a tree built from the set shows next to its rows.
    """
    filteredChildrenWithCounts(parentNode: ID!, parentNodeType: NodeType!, compact: Boolean! = false): [FilteredChild!]!

    """
    The dependencies whose source lies in the subtree of a selected SOURCE node and whose target lies in
    the subtree of a selected TARGET node. A side no selection names ids for is not restricted; a side
    selected only with unknown ids keeps nothing.
    """
    filteredDependencies(nodeSelection: [NodeSelection!]!): FilteredDependencies!
}

"A child of `filteredChildrenWithCounts`: the node and the dependencies with their end on one side in its subtree."
type FilteredChild {
    node: Node!
    "The number of those dependencies."
    dependencies: Int!
    "Their individual references, summed."
    references: Int!
}

"A dependency set narrowed by `DependencySet.filteredDependencies`."
type FilteredDependencies {

    "The number of dependencies."
    size: Int!

    "The individual references the dependencies stand for: the sum of their weights."
    references: Int!

    "All dependencies, in set order."
    dependencies: [Dependency!]!

    "One 1-based page of `pageSize` dependencies. `null`, with a BAD_REQUEST, when either argument is below 1."
    dependencyPage(pageNumber: Int!, pageSize: Int!): DependencyPage

    "The children of `parentNode` whose subtree contains a source or target of these dependencies; see `DependencySet.filteredChildren`."
    filteredChildren(parentNode: ID!, parentNodeType: NodeType!, compact: Boolean! = false): [Node!]!

    "The ids of `filteredChildren`."
    filteredChildrenIds(parentNode: ID!, parentNodeType: NodeType!, compact: Boolean! = false): [ID!]!

    """
    `filteredChildren` with, for each child, how many of the dependencies have their end on that side in
    its subtree, and their references: what a tree built from the set shows next to its rows.
    """
    filteredChildrenWithCounts(parentNode: ID!, parentNodeType: NodeType!, compact: Boolean! = false): [FilteredChild!]!

    "The distinct sources (SOURCE) or targets (TARGET) of these dependencies."
    nodes(nodeType: NodeType!, includePredecessors: Boolean! = false): [Node!]!

    "The ids of `nodes`."
    nodeIds(nodeType: NodeType!, includePredecessors: Boolean! = false): [ID!]!

    """
    Everything the sources (SOURCE) or targets (TARGET) of these dependencies depend on, across the whole
    graph, not only within this set: "what else do the types in this cell use?".
    """
    referencedNodes(nodeType: NodeType!, includePredecessors: Boolean! = false): [Node!]!

    "The ids of `referencedNodes`."
    referencedNodeIds(nodeType: NodeType!, includePredecessors: Boolean! = false): [ID!]!
}

"One side of a `filteredDependencies` selection."
input NodeSelection {

    "The selected nodes; each stands for its subtree."
    selectedNodeIds: [ID!]!

    "Which side of the dependencies the nodes select."
    selectedNodesType: NodeType!
}

"Two node ids: a dependency's source and target, each standing for its subtree."
input NodePair {

    "The depending end."
    sourceId: ID!

    "The end depended upon."
    targetId: ID!
}

"The aggregated dependency of one `NodePair`."
type NodePairDependency {

    "The source id as given."
    sourceId: ID!

    "The target id as given."
    targetId: ID!

    "The source node; `null` when `sourceId` names no node."
    sourceNode: Node

    "The target node; `null` when `targetId` names no node."
    targetNode: Node

    """
    The number of individual references from the source's subtree into the target's: the summed weight of
    the core dependencies between them. 0 when there are none, or when an end names no node.
    """
    weight: Int!
}

"A key-value pair."
type MapEntry {
    "The key."
    key: String!
    "The value; `null` when the underlying fact is."
    value: String
}
