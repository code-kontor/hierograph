<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.hierograph</groupId>
		<artifactId>hierograph-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../hierograph-parent/pom.xml</relativePath>
	</parent>

	<groupId>io.hierograph</groupId>
	<artifactId>hierograph-core</artifactId>

	<packaging>pom</packaging>

	<name>Hierograph Core</name>
	<description>Core infrastructure modules for Hierograph.</description>
	<url>http://www.slizaa.org</url>
	<inceptionYear>2018</inceptionYear>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>wuetherich</id>
			<name>Gerd Wuetherich</name>
			<email>gerd.wuetherich@code-kontor.io</email>
			<url>http://www.code-kontor.io</url>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git://github.com/slizaa/slizaa-core.git</connection>
		<developerConnection>scm:git:ssh://github.com:slizaa/slizaa-core.git</developerConnection>
		<url>http://github.com/slizaa/slizaa-core</url>
	</scm>

	<distributionManagement>
		<snapshotRepository>
			<id>ossrh</id>
			<url>https://oss.sonatype.org/content/repositories/snapshots</url>
		</snapshotRepository>
		<repository>
			<id>ossrh</id>
			<url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>
		</repository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<jqassistant.version>2.9.1</jqassistant.version>
	</properties>

	<modules>
		<module>io.hierograph.boltclient</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>com.buschmais.jqassistant</groupId>
				<artifactId>jqassistant-maven-plugin</artifactId>
				<version>${jqassistant.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>scan</goal>
							<goal>analyze</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>