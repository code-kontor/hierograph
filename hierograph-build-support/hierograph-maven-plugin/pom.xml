<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.hierograph</groupId>
        <artifactId>hierograph-build-support</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hierograph-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>Hierograph Maven Plugin</name>
    <description>
        Connects a Maven build to the Hierograph MCP server. The `create-descriptor` and `merge-descriptors`
        goals report the reactor's module layout (GAV, compiled-output directories and the resolved
        classpath) as a `.hierograph/manifest.json` for a watching server that does the scanning itself;
        the `scan` goal instead scans a module's compiled classes into a per-module `.hierograph` archive
        keyed by its GAV and attaches it so `mvn deploy` publishes it beside the jar.
    </description>

    <properties>
        <maven.api.version>3.9.9</maven.api.version>
        <maven.plugin.tools.version>3.13.1</maven.plugin.tools.version>
    </properties>

    <dependencies>
        <!-- The build-tool-independent manifest model, merge and writer. -->
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>hierograph-manifest</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <!-- The bytecode scanner + the Parquet writer/model it produces (for the `scan` goal). -->
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.graphstore.jvm.scanner</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.graphstore.jvm</artifactId>
        </dependency>

        <!-- Maven plugin API (provided by the running Maven). -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.tools.version}</version>
                <configuration>
                    <goalPrefix>hierograph</goalPrefix>
                </configuration>
                <executions>
                    <execution>
                        <id>default-descriptor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>descriptor</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
