<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.hierograph</groupId>
        <artifactId>hierograph-mcp</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>io.hierograph.mcp.server</artifactId>
    <packaging>jar</packaging>
    <name>Hierograph MCP Server</name>

    <properties>
        <!-- The server is an application (fat jar), shipped as a Docker image rather
             than a Maven Central library. Keep it out of `-Prelease deploy`. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>
        <!-- Boot 4 renamed spring-boot-starter-aop to spring-boot-starter-aspectj. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- hierograph -->
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.mcp.javaspec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.boltclient</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.core.model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.core.algorithms</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.service</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.serialization</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.mcp.jqassistant</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.graphql</artifactId>
        </dependency>

        <!-- kotlin -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.hierograph.mcp.server.McpApplicationKt</mainClass>
                    <!-- Attach the runnable fat jar under the `exec` classifier so the
                         plain thin jar stays the module's main artifact. Downstream
                         modules (e.g. io.hierograph.itest.tests) must compile against the
                         server's classes, which a repackaged fat jar hides under
                         BOOT-INF/classes. The runnable jar is target/*-exec.jar. -->
                    <classifier>exec</classifier>
                </configuration>
                <!-- Repackage the thin jar into a self-contained, runnable
                     Spring Boot jar so `java -jar` and the Docker image work. -->
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The Docker image is opt-in: it is not part of the default build and
            requires a running Docker daemon. Activate with `-Pdocker`
            (e.g. `mvn -Pdocker package`) to build the Hierograph MCP server image.

            This uses a Dockerfile driven by the docker CLI (same pattern as
            hierograph-itest/io.hierograph.itest.image), rather than Spring Boot's
            build-image goal: the buildpack platform bundled with Spring Boot pins
            Docker API v1.24, which Docker Engine 29+ rejects ("client version 1.24
            is too old"). The docker CLI negotiates a supported API version.
        -->
        <profile>
            <id>docker</id>
            <properties>
                <!-- Image coordinates. Defaults publish to GitHub Container Registry
                     under the code-kontor org; override -Ddocker.registry or
                     -Ddocker.image.shortname to retarget. -->
                <docker.registry>ghcr.io/code-kontor</docker.registry>
                <docker.image.shortname>hierograph-mcp-server</docker.image.shortname>
                <docker.image.name>${docker.registry}/${docker.image.shortname}:${project.version}</docker.image.name>
                <!-- Push is opt-in: a plain `-Pdocker package` only builds locally.
                     Flip with `-Ddocker.push.skip=false` (run `docker login ghcr.io`
                     first). The push is bound to the `deploy` phase. -->
                <docker.push.skip>true</docker.push.skip>
                <!-- The push path builds a multi-arch image with `docker buildx`
                     and pushes the manifest list in one step (multi-arch images
                     cannot be kept in the local image store, so build+push are
                     combined). Override -Ddocker.platforms to retarget. -->
                <docker.platforms>linux/amd64,linux/arm64</docker.platforms>
                <!-- Multi-platform builds need a `docker-container` buildx builder
                     (the default `docker` driver can't do multi-arch); a dedicated
                     named builder is created on demand and reused across runs. -->
                <docker.buildx.builder>hierograph-builder</docker.buildx.builder>
            </properties>
            <build>
                <plugins>
                    <!-- Stage the Docker build context under target/docker: the
                         Dockerfile and the repackaged Spring Boot jar. Bound to
                         `package` after spring-boot:repackage (declared in the main
                         build, so it runs first). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-docker-context</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/docker</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}</directory>
                                            <includes>
                                                <include>Dockerfile</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}-exec.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>docker-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.build.directory}/docker</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--build-arg</argument>
                                        <argument>JAR_FILE=${project.build.finalName}-exec.jar</argument>
                                        <argument>-t</argument>
                                        <argument>${docker.image.name}</argument>
                                        <argument>.</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <!-- Ensure a multi-arch-capable buildx builder exists
                                 (idempotent: inspect, else create). Uses the
                                 docker-container driver, which the default `docker`
                                 driver cannot substitute for multi-platform builds.
                                 On Linux, cross-arch emulation also needs QEMU/binfmt
                                 registered once via the tonistiigi/binfmt image
                                 (pre-installed on Docker Desktop). Opt-in with the
                                 push, bound to deploy. -->
                            <execution>
                                <id>docker-buildx-builder</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${docker.push.skip}</skip>
                                    <executable>sh</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>docker buildx inspect "$1" &gt;/dev/null 2&gt;&amp;1 || docker buildx create --name "$1" --driver docker-container --bootstrap</argument>
                                        <argument>sh</argument>
                                        <argument>${docker.buildx.builder}</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <!-- Build the multi-arch image and push the manifest list
                                 in one step (multi-arch can't be loaded into the local
                                 image store, so build+push are combined). Opt-in via
                                 -Ddocker.push.skip=false; bound to `deploy` so a plain
                                 `-Pdocker package` never pushes. Requires a prior
                                 `docker login` to the target registry. -->
                            <execution>
                                <id>docker-buildx-push</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${docker.push.skip}</skip>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.build.directory}/docker</workingDirectory>
                                    <arguments>
                                        <argument>buildx</argument>
                                        <argument>build</argument>
                                        <argument>--builder</argument>
                                        <argument>${docker.buildx.builder}</argument>
                                        <argument>--platform</argument>
                                        <argument>${docker.platforms}</argument>
                                        <argument>--build-arg</argument>
                                        <argument>JAR_FILE=${project.build.finalName}-exec.jar</argument>
                                        <argument>-t</argument>
                                        <argument>${docker.image.name}</argument>
                                        <argument>--push</argument>
                                        <argument>.</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
