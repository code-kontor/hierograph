<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.hierograph</groupId>
        <artifactId>hierograph-mcp</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>io.hierograph.mcp.server</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- hierograph -->
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.mcp.javaspec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.boltclient</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.core.model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.core.algorithms</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.graphdb.model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.service</artifactId>
        </dependency>
        <dependency>
            <groupId>io.hierograph</groupId>
            <artifactId>io.hierograph.mcp.jqassistant</artifactId>
        </dependency>

        <!-- kotlin -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.hierograph.mcp.server.McpApplicationKt</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
