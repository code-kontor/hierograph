<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.hierograph</groupId>
    <artifactId>hierograph-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Hierograph Parent</name>
    <description>Parent POM for the Hierograph project.</description>
    <url>https://www.hierograph.io</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>wuetherich</id>
            <name>Gerd Wuetherich</name>
            <email>gerd.wuetherich@code-kontor.io</email>
            <url>http://www.code-kontor.io</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/code-kontor/io.hierograph.git</connection>
        <developerConnection>scm:git:ssh://github.com:code-kontor/io.hierograph.git</developerConnection>
        <url>https://github.com/code-kontor/io.hierograph</url>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <properties>
        <java.version>21</java.version>
        <kotlin.version>2.1.21</kotlin.version>

        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <exec-maven-plugin.version>3.5.0</exec-maven-plugin.version>

        <jqassistant.version>2.9.1</jqassistant.version>
        <neo4j-java-driver.version>5.28.13</neo4j-java-driver.version>
        <spring-boot.version>3.3.4</spring-boot.version>
        <spring-ai.version>1.1.6</spring-ai.version>
        <assertj.version>3.26.3</assertj.version>
        <junit-jupiter.version>5.11.2</junit-jupiter.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <slf4j.version>2.0.17</slf4j.version>
    </properties>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>4.6</version>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <inlineHeader><![CDATA[Copyright 2026 Gerd Wuetherich

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.]]></inlineHeader>
                            <includes>
                                <include>**/*.kt</include>
                                <include>**/*.java</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>

            <!-- ==================== -->
            <!-- BOM imports          -->
            <!-- ==================== -->
            <!-- Must precede spring-boot-dependencies: Spring Boot's BOM pins an older
                 Testcontainers (and thus docker-java) version, and the first import wins. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ==================== -->
            <!-- Kotlin               -->
            <!-- ==================== -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-test-junit5</artifactId>
                <version>${kotlin.version}</version>
            </dependency>

            <!-- ==================== -->
            <!-- Neo4j java driver    -->
            <!-- ==================== -->
            <dependency>
                <groupId>org.neo4j.driver</groupId>
                <artifactId>neo4j-java-driver</artifactId>
                <version>${neo4j-java-driver.version}</version>
            </dependency>

            <!-- ==================== -->
            <!-- Test                 -->
            <!-- ==================== -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- ==================== -->
            <!-- Hierograph modules   -->
            <!-- ==================== -->
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.boltclient</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.core.model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.core.algorithms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.graphdb.model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.serialization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.mcp.javaspec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.mcp.jqassistant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.mcp.server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.jqassistant.rules</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.graphql</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
            jQAssistant scan/analyze is opt-in: it is not part of the default build.
            Activate with `-Pjqassistant` (e.g. `mvn -Pjqassistant verify`) to run it.
        -->
        <profile>
            <id>jqassistant</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.buschmais.jqassistant</groupId>
                        <artifactId>jqassistant-maven-plugin</artifactId>
                        <version>${jqassistant.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>scan</goal>
                                    <goal>analyze</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
