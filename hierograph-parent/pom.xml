<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.hierograph</groupId>
    <artifactId>hierograph-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>Hierograph Parent</name>
    <description>Parent POM for the Hierograph project.</description>
    <url>https://www.hierograph.io</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>wuetherich</id>
            <name>Gerd Wuetherich</name>
            <email>gerd.wuetherich@code-kontor.io</email>
            <url>http://www.code-kontor.io</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/code-kontor/io.hierograph.git</connection>
        <developerConnection>scm:git:ssh://github.com:code-kontor/io.hierograph.git</developerConnection>
        <url>https://github.com/code-kontor/io.hierograph</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <kotlin.version>2.4.0</kotlin.version>

        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>

        <jqassistant.version>2.9.1</jqassistant.version>
        <neo4j-java-driver.version>6.2.0</neo4j-java-driver.version>
        <spring-boot.version>4.1.0</spring-boot.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <assertj.version>3.27.7</assertj.version>
        <junit-jupiter.version>6.1.1</junit-jupiter.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <slf4j.version>2.0.18</slf4j.version>
    </properties>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration/>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.0.0</version>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <inlineHeader><![CDATA[Copyright 2026 Gerd Wuetherich

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.]]></inlineHeader>
                            <includes>
                                <include>**/*.kt</include>
                                <include>**/*.java</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>

            <!-- ==================== -->
            <!-- BOM imports          -->
            <!-- ==================== -->
            <!-- Must precede spring-boot-dependencies: Spring Boot's BOM pins older
                 Testcontainers (and thus docker-java) and JUnit versions, and the first
                 import wins. The JUnit BOM keeps junit-platform aligned with junit-jupiter
                 at 6.x (Spring Boot's BOM would otherwise pull an incompatible platform). -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ==================== -->
            <!-- Kotlin               -->
            <!-- ==================== -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-test-junit5</artifactId>
                <version>${kotlin.version}</version>
            </dependency>

            <!-- ==================== -->
            <!-- Neo4j java driver    -->
            <!-- ==================== -->
            <dependency>
                <groupId>org.neo4j.driver</groupId>
                <artifactId>neo4j-java-driver</artifactId>
                <version>${neo4j-java-driver.version}</version>
            </dependency>

            <!-- ==================== -->
            <!-- Test                 -->
            <!-- ==================== -->
            <!-- junit-jupiter version is managed by the junit-bom import above. -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- ==================== -->
            <!-- Hierograph modules   -->
            <!-- ==================== -->
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.boltclient</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.core.model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.core.algorithms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.graphdb.model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.graphdb.mapping.service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.hierarchicalgraph.serialization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.mcp.javaspec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.mcp.jqassistant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.mcp.server</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.jqassistant.rules</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.hierograph</groupId>
                <artifactId>io.hierograph.graphql</artifactId>
                <version>${project.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <profiles>
        <!--
            Maven Central release is opt-in: it is not part of the default build.
            Activate with `-Prelease` (e.g. `mvn -Prelease deploy`) to attach the
            -sources/-javadoc jars, GPG-sign every artifact, and upload to the
            Central Publisher Portal. A non-SNAPSHOT version is required.

            Credentials live outside the POM: ~/.m2/settings.xml must hold a
            <server> with <id>central</id> (your Portal user token) and a published
            GPG key (passphrase via gpg-agent or -Dgpg.passphrase=...).
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- -sources.jar (required by Central) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- -javadoc.jar (required by Central). Dokka because this is
                         Kotlin; maven-javadoc-plugin would produce an empty jar from
                         .kt sources. -->
                    <plugin>
                        <groupId>org.jetbrains.dokka</groupId>
                        <artifactId>dokka-maven-plugin</artifactId>
                        <version>2.0.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadoc</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>javadocJar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- GPG-sign every artifact (.jar, -sources, -javadoc, .pom) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!-- GnuPG 2.1+ (here 2.5.x) ignores the passphrase
                                 supplied via gpg.passphrase unless loopback
                                 pinentry is used; without this the agent is
                                 consulted and signing fails with "bad
                                 passphrase" even when the passphrase is correct. -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Uploads to the Central Publisher Portal; replaces
                         nexus-staging and the old distributionManagement deploy. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- false = upload to a staged deployment you review and
                                 click "Publish" on in the portal. Set true to auto-release. -->
                            <autoPublish>false</autoPublish>
                            <!-- Keep the MCP server application out of Central. It is
                                 shipped as a Docker image, not a library. maven.deploy.skip
                                 alone does NOT work here: this plugin replaces the deploy
                                 lifecycle and ignores it, so it must be excluded explicitly.
                                 Entries are matched by artifactId only. -->
                            <excludeArtifacts>
                                <excludeArtifact>io.hierograph.mcp.server</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            jQAssistant scan/analyze is opt-in: it is not part of the default build.
            Activate with `-Pjqassistant` (e.g. `mvn -Pjqassistant verify`) to run it.
        -->
        <profile>
            <id>jqassistant</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.buschmais.jqassistant</groupId>
                        <artifactId>jqassistant-maven-plugin</artifactId>
                        <version>${jqassistant.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>scan</goal>
                                    <goal>analyze</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
