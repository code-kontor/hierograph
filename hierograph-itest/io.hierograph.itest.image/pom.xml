<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.hierograph</groupId>
        <artifactId>hierograph-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../../hierograph-parent/pom.xml</relativePath>
    </parent>

    <name>Hierograph Integration Test Example Image</name>
    <artifactId>io.hierograph.itest.image</artifactId>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <docker.image.name>${project.artifactId}:${project.version}</docker.image.name>
    </properties>

    <profiles>
        <!--
            The integration-test image is opt-in: it is not part of the default build.
            Activate with `-Pitest` (e.g. `mvn -Pitest package`) to build the Docker image.
        -->
        <profile>
            <id>itest</id>

            <!-- The rules plugin is baked into the image; declaring it as a
                 dependency forces the reactor to build it before this module. -->
            <dependencies>
                <dependency>
                    <groupId>io.hierograph</groupId>
                    <artifactId>io.hierograph.jqassistant.rules</artifactId>
                    <scope>provided</scope>
                </dependency>
            </dependencies>

            <build>
                <plugins>
                    <!-- Stage the Docker build context under target/docker:
                         the Dockerfile, the jar-download script and the project's
                         root .jqassistant.yml used to scan the Spring jars. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-docker-context</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/docker</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}</directory>
                                            <includes>
                                                <include>Dockerfile</include>
                                                <include>download-jars.sh</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>${maven.multiModuleProjectDirectory}</directory>
                                            <includes>
                                                <include>.jqassistant.yml</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Copy the rule-only plugin jar into the build context. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-rules-plugin</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>io.hierograph</groupId>
                                            <artifactId>io.hierograph.jqassistant.rules</artifactId>
                                            <type>jar</type>
                                            <destFileName>rules.jar</destFileName>
                                        </artifactItem>
                                    </artifactItems>
                                    <outputDirectory>${project.build.directory}/docker/plugin</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>docker-build</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>docker</executable>
                                    <workingDirectory>${project.build.directory}/docker</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--build-arg</argument>
                                        <argument>RULES_VERSION=${project.version}</argument>
                                        <argument>-t</argument>
                                        <argument>${docker.image.name}</argument>
                                        <argument>.</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>