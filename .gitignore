# macOS
.DS_Store

# Build output
target/
reports/
logs/

# Hierograph build manifest (written by hierograph:manifest for the local MCP server)
.hierograph/

# Hierograph graph dump (written by the server on each load)
hierarchical-graph.txt

# Manual Parquet export (ExportParquetManualIT)
jqa-parquet-export/

# Local example inputs for the scanner CLI (Spring jars, demo snapshots, …)
/example/

# Maven wrapper local cache
.mvn/

# Claude Code workspace
# Project skills under .claude/skills/ are tracked; everything else
# (settings.local.json, per-user state) stays per-user.
.claude/*
!.claude/skills/

# Embedded test database


# IntelliJ IDEA
# Shared project configuration under .idea/ is tracked.
# Per-user files (workspace.xml, shelf/, dataSources/, ...) are excluded
# by .idea/.gitignore, which IntelliJ maintains automatically.
*.iml
*.iws
out/
/mcp-example-db/
